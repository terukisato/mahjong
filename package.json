{
  "name": "janshin",
  "version": "0.17.1",
  "description": "Janshin (雀心) — riichi mahjong web game",
  "main": "server/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node --test \"server/**/*.test.js\"",
    "test:watch": "node --test --watch \"server/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"server/**/*.test.js\" \"server/**/*.test.js\"",
    "migrate-db": "node server/migrate-json-to-sqlite.js"
  },
  "keywords": [
    "mahjong",
    "riichi",
    "game"
  ],
  "author": "Teruki Sato",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.21.0"
  }
}
