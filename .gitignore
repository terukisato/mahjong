node_modules/
npm-debug.log
yarn-error.log

# Environment / secrets
.env
.env.*.local

# Claude Code local tooling config (dev-server launch config, local perms)
.claude/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Scratch files used while iterating on tile art
public/tile-preview.html

# Live player data (profiles.json, player-stats.json) — mutated by the
# running server on every game/rename/etc. Was committed once by mistake;
# a later `git pull`/checkout on a deployment overwrote the live files with
# that stale commit and silently erased everything written since. Never
# track these — back them up out-of-band if needed, don't rely on git.
server/data/*.json

# Same reasoning as the JSON files above, now that server/db.js persists the
# same live player data in SQLite instead — the database file itself, plus
# its WAL-mode sidecar files (server/db.js turns on `PRAGMA journal_mode =
# WAL`, which keeps not-yet-checkpointed writes in -wal, with -shm as its
# shared index).
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
